# ==========================================================================
# Cấu hình Pi-hole cho tên miền nội bộ
# Sao chép: cp .env.example .env   (file .env đã được .gitignore)
# ==========================================================================

# IP LAN của máy chạy Pi-hole (cũng là IP mà vps.vn sẽ trỏ tới).
# Máy này có 2 dải LAN (192.168.2.x và 192.168.1.x); chọn dải mà
# các thiết bị khác thực sự dùng. Tự dò: ip -4 route get 1.1.1.1
LAN_IP=192.168.2.38

# Tên miền nội bộ. Mọi subdomain cũng được trỏ về LAN_IP.
VPS_HOSTNAME=vps.vn

# Mật khẩu giao diện quản trị Pi-hole (http://<LAN_IP>/admin).
# Đổi thành chuỗi riêng, không dùng mật khẩu bạn dùng ở nơi khác.
PIHOLE_PASSWORD=doi-mat-khau-nay

# DNS upstream để Pi-hole hỏi tiếp ra Internet (phân tách bằng dấu ;).
# Giữ dấu nháy kép: nếu bỏ, Bash sẽ hiểu dấu ; là phân cách lệnh khi nạp file.
UPSTREAM_DNS="1.1.1.1;1.0.0.1"

# Cổng giao diện quản trị Pi-hole (bản Docker). Mặc định 80; nếu WebApp
# của bạn cũng chiếm cổng 80 thì đổi sang 8080.
#PIHOLE_ADMIN_PORT=8080

TZ=Asia/Ho_Chi_Minh
